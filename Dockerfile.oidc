# Twenty + OIDC retrait EnterpriseFeaturesEnabledGuard
# Patch sso.resolver.ts + sso-auth.controller.ts → SSO providers accessibles sans licence Enterprise.
# Nécessite un rebuild twenty-server (TypeScript compilation).
ARG TWENTY_VERSION=v1.21.0

FROM node:24-bookworm-slim AS builder
ARG TWENTY_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /
RUN git clone --depth 1 --branch "${TWENTY_VERSION}" https://github.com/twentyhq/twenty.git /build
WORKDIR /build
COPY packages/twenty-server/src/engine/core-modules/sso/sso.resolver.ts packages/twenty-server/src/engine/core-modules/sso/sso.resolver.ts
COPY packages/twenty-server/src/engine/core-modules/auth/controllers/sso-auth.controller.ts packages/twenty-server/src/engine/core-modules/auth/controllers/sso-auth.controller.ts
RUN corepack enable && yarn install --immutable && \
    yarn nx build twenty-server

FROM twentycrm/twenty:${TWENTY_VERSION} AS twenty-oidc
COPY --from=builder /build/packages/twenty-server/dist /app/packages/twenty-server/dist
